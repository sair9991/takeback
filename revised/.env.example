# Database Credentials
POSTGRES_USER=chess_user
POSTGRES_PASSWORD=chess_password
POSTGRES_DB=chess_db
DATABASE_URL=postgresql://chess_user:chess_password@db:5432/chess_db

# Engine & Model Configuration
STOCKFISH_PATH=/usr/games/stockfish
GEMMA_API_URL=http://gemma:8080
GEMMA_TIMEOUT=60.0
DEFAULT_DEVICE=cpu

# Authentication & JWT Security
JWT_SECRET=change-this-in-production-secret-key-32chars-min
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Google OAuth2 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Client Application URL
FRONTEND_URL=http://localhost:3000
